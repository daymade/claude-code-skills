+    if (!params.use_gpu) {
+        fprintf(stderr, "ASR_GPU_BLOCKED reason=cpu-requested\n");
+        return 5;
+    }
+    int gpu_count = 0;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        const auto type = ggml_backend_dev_type(ggml_backend_dev_get(i));
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            ++gpu_count;
+        }
+    }
+    if (params.gpu_device < 0 || params.gpu_device >= gpu_count) {
+        fprintf(stderr, "ASR_GPU_BLOCKED reason=gpu-device-unavailable\n");
+        return 5;
+    }
