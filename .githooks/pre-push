#!/bin/bash
# Repository dispatcher: replay the exact pre-push update set to both the
# mainline/version guard and the maintainer's shared PII guard.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
REPO_ROOT="$(cd "$REPO_ROOT" && pwd -P)"
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
COMMON_DIR="$(cd "$COMMON_DIR" && pwd -P)"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd -P)"
cd "$REPO_ROOT"

HOOK_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/claude-code-skills-pre-push.XXXXXX")"
trap 'rm -rf -- "$HOOK_TMP_DIR"' EXIT
UPDATE_INPUT="$HOOK_TMP_DIR/updates"

REPOSITORY_PATHS=("$REPO_ROOT" "$COMMON_DIR")
WORKTREE_INVENTORY="$HOOK_TMP_DIR/worktrees.z"
if ! git worktree list --porcelain -z >"$WORKTREE_INVENTORY"; then
  echo "pre-push blocked: could not enumerate repository worktrees for publication runtime containment." >&2
  exit 2
fi

record_active=0
have_head=0
have_ref=0
saw_bare=0
record_count=0
current_seen=0
worktree_path=""
while IFS= read -r -d '' field; do
  if [ -z "$field" ]; then
    if [ "$record_active" -eq 0 ]; then
      echo "pre-push blocked: repository worktree inventory is malformed." >&2
      exit 2
    fi
    if [ "$saw_bare" -eq 0 ] && { [ "$have_head" -eq 0 ] || [ "$have_ref" -eq 0 ]; }; then
      echo "pre-push blocked: repository worktree inventory is malformed." >&2
      exit 2
    fi
    if [ -d "$worktree_path" ]; then
      resolved_worktree="$(cd "$worktree_path" && pwd -P)" || exit 2
      REPOSITORY_PATHS+=("$resolved_worktree")
      [ "$resolved_worktree" = "$REPO_ROOT" ] && current_seen=1
    fi
    record_count=$((record_count + 1))
    record_active=0
    have_head=0
    have_ref=0
    saw_bare=0
    worktree_path=""
    continue
  fi

  if [ "$record_active" -eq 0 ]; then
    case "$field" in
      "worktree "*) worktree_path="${field#worktree }" ;;
      *)
        echo "pre-push blocked: repository worktree inventory is malformed." >&2
        exit 2
        ;;
    esac
    record_active=1
  elif [ "$saw_bare" -eq 1 ]; then
    case "$field" in
      locked|locked\ *|prunable\ *) ;;
      *)
        echo "pre-push blocked: repository worktree inventory is malformed." >&2
        exit 2
        ;;
    esac
  elif [ "$have_head" -eq 0 ]; then
    if [ "$field" = "bare" ]; then
      saw_bare=1
    elif [[ "$field" =~ ^HEAD\ ([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$ ]]; then
      have_head=1
    else
      echo "pre-push blocked: repository worktree inventory is malformed." >&2
      exit 2
    fi
  elif [ "$have_ref" -eq 0 ]; then
    case "$field" in
      detached) have_ref=1 ;;
      "branch "*)
        [ "${field#branch }" != "" ] || {
          echo "pre-push blocked: repository worktree inventory is malformed." >&2
          exit 2
        }
        have_ref=1
        ;;
      *)
        echo "pre-push blocked: repository worktree inventory is malformed." >&2
        exit 2
        ;;
    esac
  else
    case "$field" in
      locked|locked\ *|prunable\ *) ;;
      *)
        echo "pre-push blocked: repository worktree inventory is malformed." >&2
        exit 2
        ;;
    esac
  fi
done <"$WORKTREE_INVENTORY"

if [ "$record_active" -ne 0 ] || [ "$record_count" -eq 0 ] || [ "$current_seen" -ne 1 ]; then
  echo "pre-push blocked: repository worktree inventory is malformed or truncated." >&2
  exit 2
fi

# Cross-check Git's administrative linked-worktree records so a valid-looking
# but incomplete porcelain inventory cannot omit a repository-controlled path.
if [ -d "$COMMON_DIR/worktrees" ]; then
  if [ ! -r "$COMMON_DIR/worktrees" ] || [ ! -x "$COMMON_DIR/worktrees" ]; then
    echo "pre-push blocked: linked-worktree administrative records are unreadable." >&2
    exit 2
  fi
  shopt -s nullglob
  for gitdir_file in "$COMMON_DIR"/worktrees/*/gitdir; do
    [ -f "$gitdir_file" ] || continue
    IFS= read -r gitdir_line <"$gitdir_file" || {
      echo "pre-push blocked: linked-worktree gitdir record is unreadable." >&2
      exit 2
    }
    case "$gitdir_line" in
      "gitdir: "*) linked_git_path="${gitdir_line#gitdir: }" ;;
      /*) linked_git_path="$gitdir_line" ;;
      *)
        echo "pre-push blocked: linked-worktree gitdir record is malformed." >&2
        exit 2
        ;;
    esac
    case "$linked_git_path" in
      /*) ;;
      *)
        echo "pre-push blocked: linked-worktree gitdir record is malformed." >&2
        exit 2
        ;;
    esac
    [ -f "$linked_git_path" ] || continue
    linked_root="$(cd -P "$(dirname "$linked_git_path")" && pwd)" || {
      echo "pre-push blocked: linked-worktree path cannot be resolved." >&2
      exit 2
    }
    REPOSITORY_PATHS+=("$linked_root")
  done
  shopt -u nullglob
fi

resolve_existing_path() {
  local value="$1" links=0 directory target
  while [ -L "$value" ]; do
    links=$((links + 1))
    if [ "$links" -gt 40 ]; then
      echo "pre-push blocked: too many symlinks while resolving publication runtime." >&2
      return 2
    fi
    directory="$(cd -P "$(dirname "$value")" && pwd)"
    target="$(readlink "$value")"
    case "$target" in
      /*) value="$target" ;;
      *) value="$directory/$target" ;;
    esac
  done
  directory="$(cd -P "$(dirname "$value")" && pwd)"
  printf '%s/%s\n' "$directory" "$(basename "$value")"
}

path_is_within() {
  local candidate="$1" root="$2"
  [ "$candidate" = "$root" ] || [[ "$candidate" == "$root/"* ]]
}

require_external_path() {
  local label="$1" resolved="$2" repository_path
  for repository_path in "${REPOSITORY_PATHS[@]}"; do
    if path_is_within "$resolved" "$repository_path"; then
      echo "pre-push blocked: $label resolves inside the repository; configure an external executable guard/runtime." >&2
      exit 2
    fi
  done
}

cat >"$UPDATE_INPUT"

node "$REPO_ROOT/scripts/git-mainline-guard.mjs" pre-push "$@" <"$UPDATE_INPUT"

GLOBAL_GUARD_DIR="${GIT_PII_GUARD_DIR:-${HOME:-}/scripts/git-pii-guard}"
if [ ! -x "$GLOBAL_GUARD_DIR/pre-push" ]; then
  echo "pre-push blocked: shared PII pre-push guard is unavailable; refusing an unscanned public push." >&2
  exit 2
fi
if [ "$GLOBAL_GUARD_DIR/pre-push" -ef "$HOOK_DIR/pre-push" ]; then
  echo "pre-push blocked: PII guard resolves to the repository dispatcher itself; configure an external executable guard." >&2
  exit 2
fi
GLOBAL_GUARD_PATH="$(resolve_existing_path "$GLOBAL_GUARD_DIR/pre-push")" || exit 2
require_external_path "PII guard" "$GLOBAL_GUARD_PATH"

PUBLICATION_PYTHON="${HOME:-}/.local/bin/python3.12"
PUBLICATION_RUNNER="$GLOBAL_GUARD_DIR/../claude-hooks/bounded-hook-runner.py"
if [ ! -x "$PUBLICATION_PYTHON" ] || [ ! -f "$PUBLICATION_RUNNER" ]; then
  echo "pre-push blocked: publication budget runtime is unavailable." >&2
  exit 2
fi
PUBLICATION_PYTHON_PATH="$(resolve_existing_path "$PUBLICATION_PYTHON")" || exit 2
PUBLICATION_RUNNER_PATH="$(resolve_existing_path "$PUBLICATION_RUNNER")" || exit 2
require_external_path "publication Python" "$PUBLICATION_PYTHON_PATH"
require_external_path "publication runner" "$PUBLICATION_RUNNER_PATH"

"$PUBLICATION_PYTHON_PATH" "$PUBLICATION_RUNNER_PATH" \
  --pass-through --timeout "${PII_PRE_PUSH_TIMEOUT_SECONDS-300}" --max-timeout 300 \
  --term-grace 3 -- "$GLOBAL_GUARD_PATH" "$@" <"$UPDATE_INPUT"
